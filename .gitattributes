* text=auto
.gitattributes text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.githooks/* text eol=lf
research/source_reading/linux/**/*.c text eol=lf
research/source_reading/linux/**/*.h text eol=lf
research/source_reading/linux/**/*.rst text eol=lf
research/source_reading/linux/**/Kconfig text eol=lf
research/source_reading/linux/**/Makefile text eol=lf
# Preserve whitespace in these verified upstream source copies.
research/source_reading/linux/fs/ext4/file.c whitespace=-blank-at-eof
research/source_reading/linux/fs/jbd2/journal.c whitespace=-blank-at-eof
research/source_reading/linux/fs/readdir.c whitespace=-blank-at-eol
research/source_reading/linux/fs/buffer.c whitespace=-blank-at-eol
research/source_reading/linux/include/linux/writeback.h whitespace=-blank-at-eol
research/source_reading/linux/fs/fcntl.c whitespace=-blank-at-eol,-space-before-tab
research/source_reading/linux/include/linux/poll.h whitespace=-blank-at-eol
research/source_reading/linux/include/linux/pagemap.h whitespace=-blank-at-eol
research/source_reading/linux/include/uapi/linux/fs.h whitespace=-blank-at-eol
research/source_reading/linux/Documentation/filesystems/path-lookup.rst whitespace=-blank-at-eol
research/source_reading/linux/security/commoncap.c whitespace=-blank-at-eol
research/source_reading/linux/security/Kconfig whitespace=-blank-at-eof
# Upstream RST uses tabbed indentation and seven-character heading underlines.
research/source_reading/linux/Documentation/filesystems/proc.rst whitespace=-space-before-tab conflict-marker-size=1000
research/source_reading/linux/Documentation/filesystems/sharedsubtree.rst whitespace=-space-before-tab
markbook/topics/*/releases/** text eol=lf

research/source_reading/linux/fs/eventfd.c whitespace=-blank-at-eof
research/source_reading/linux/include/linux/anon_inodes.h whitespace=-blank-at-eof
research/source_reading/linux/include/linux/eventfd.h whitespace=-blank-at-eof
research/source_reading/linux/Documentation/trace/ftrace.rst whitespace=-blank-at-eol,-space-before-tab
research/source_reading/linux/include/trace/events/syscalls.h whitespace=-blank-at-eof

# Preserve byte-identical text evidence from the Buildroot release archive.
research/source_reading/buildroot/2025.02/** text eol=lf
research/source_reading/buildroot/2025.02/docs/manual/customize-configuration.adoc whitespace=-blank-at-eof
research/source_reading/buildroot/2025.02/docs/manual/how-buildroot-works.adoc whitespace=-blank-at-eof
