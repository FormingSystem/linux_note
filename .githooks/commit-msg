#!/bin/sh

msg_file="$1"
subject="$(sed -n '1p' "$msg_file")"
type_regex='feat|fix|refactor|perf|security|content|docs|test|build|ci|release|revert|chore'
scope_regex='[^/()[:space:]:]+(/[^/()[:space:]:]+)?'
format_regex="^(${type_regex})(\\((${scope_regex})\\))?(!)?: .+$"

if ! printf '%s\n' "$subject" | grep -Eq "$format_regex"; then
  cat >&2 <<'EOF'
提交标题格式错误。

必须使用：
  <类型>[(<project>/<module>)]!?: <中文结果>

  - 描述1
  - 描述2

类型：
  feat fix refactor perf security content docs test build ci release revert chore

示例：
  feat(publication/export): 支持按清单导出专题文档
  refactor(repository/format)!: 统一文档检查入口
  docs: 更新仓库说明
  content(knowledge/rcu): 补充宽限期状态汇聚过程
EOF
  exit 1
fi

description="$(printf '%s\n' "$subject" | sed 's/^[^:]*: //')"
if ! printf '%s\n' "$description" | LC_ALL=C grep -q '[^ -~]'; then
  printf '%s\n' '提交标题中的结果说明必须包含中文。' >&2
  exit 1
fi

body_lines="$(tail -n +2 "$msg_file" | grep -Ev '^[[:space:]]*(#.*)?$' || true)"
if [ -z "$body_lines" ]; then
  printf '%s\n' '提交必须在标题后空一行，并至少提供一条“- 描述”明细。' >&2
  exit 1
fi

if ! sed -n '2p' "$msg_file" | grep -Eq '^[[:space:]]*$'; then
  printf '%s\n' '提交标题与明细之间必须保留一个空行。' >&2
  exit 1
fi

if printf '%s\n' "$body_lines" | grep -Ev '^- [^[:space:]].*' >/dev/null; then
  printf '%s\n' '每条提交明细必须使用“- 描述”，描述不得为空或只有空白。' >&2
  exit 1
fi

exit 0
