C MP+onceassign+derefonce

(*
 * Result: Never
 *
 * RCU reader 取得新指针后，能否仍看到对象初始化前的旧值？
 *)

{
p=y;
}

P0(int *x, int **p)
{
	WRITE_ONCE(*x, 1);
	rcu_assign_pointer(*p, x);
}

P1(int *x, int **p)
{
	int *r0;
	int r1;

	rcu_read_lock();
	r0 = rcu_dereference(*p);
	r1 = READ_ONCE(*r0);
	rcu_read_unlock();
}

exists (1:r0=x /\ 1:r1=0)
