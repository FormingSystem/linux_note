{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://practice.local/schemas/release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "display_name_zh", "display_name_en", "copyright_holder", "copyright_year", "copyright_email", "project_url", "license", "version", "channel", "repository_branch", "update_check_interval_minutes", "editable"],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "display_name_zh": { "const": "回路" },
    "display_name_en": { "const": "Loop" },
    "copyright_holder": { "type": "string", "minLength": 1 },
    "copyright_year": { "type": "integer", "minimum": 2026 },
    "copyright_email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
    "project_url": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "license": { "const": "GPL-2.0-only" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["development", "stable", "preview"] },
    "repository_branch": { "type": "string", "minLength": 1 },
    "update_check_interval_minutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
    "editable": { "const": false }
  }
}
