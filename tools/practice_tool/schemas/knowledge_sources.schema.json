{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop-practice.local/schemas/knowledge-sources.schema.json",
  "title": "Loop Knowledge Source Registry",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "location"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["filesystem", "http"] },
          "location": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
